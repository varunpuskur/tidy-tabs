{
  "manifest_version": 3,
  "name": "Tidy Tabs — AI Tab Organizer & Group Manager",
  "version": "1.8.0",
  "description": "One click sorts your tabs into named AI groups. Free with Gemini, no account, no server. Works in Chrome, Dia, Brave & Edge.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tidy tabs — right-click for Settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "tidy": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "Tidy tabs in the current window"
    },
    "undo": {
      "suggested_key": {
        "default": "Alt+Z",
        "mac": "Alt+Z"
      },
      "description": "Undo the last tidy"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "author": "Varun Puskur",
  "short_name": "Tidy Tabs"
}
